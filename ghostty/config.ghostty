# vim: ft=ghostty
# refresh shortcut: CMD+SHIFT+,

config-file = themes/tokyonight
term = xterm-256color

# custom-shader = shaders/glitchy.glsl
# custom-shader = shaders/tft.glsl
# custom-shader = shaders/bettercrt.glsl

# shell
shell-integration = "zsh"
shell-integration-features = "no-cursor"

# ghostty
auto-update = "check"
auto-update-channel = "stable"

confirm-close-surface = false

# Window settings
window-decoration = "auto"
window-inherit-working-directory = false

window-padding-x = 10
window-padding-y = 20
window-padding-balance = true

window-theme = dark
window-save-state = "never"

window-width = 1920
window-height = 1080
window-position-x = 1248
window-position-y = 1033

# window-vsync = true

# MacOS specific settings
macos-titlebar-style = "hidden"
macos-window-shadow = true
macos-auto-secure-input = true
macos-secure-input-indication = true
macos-icon = "retro"
macos-option-as-alt = "left"

# Mouse settings
mouse-hide-while-typing = true
copy-on-select = false

# Background and transparency settings
# background-image = wallpapers/wp.jpeg
# background-image-fit = cover
# background-image-position = center
# background-image-opacity = 0.08
background-opacity = 0.8
background-blur = false

# Font and cursor settings
font-family = "FiraCode Nerd Font Mono"
font-style = "Retina"
font-size = 14
font-feature = -liga,calt,-dlig
# ligature tests: => , ===, !==, <=, >=, ->, <-, =>, <=>, &&, ||, ++, --, **

bold-is-bright = true

cursor-style = block
cursor-opacity = 1.0
cursor-style-blink = false
cursor-color = cell-foreground
cursor-text = cell-background
